# Mechus + Zoom SDK: join Zoom without a browser.
# Build for linux/amd64 so pip can use the pre-built zoom-meeting-sdk wheel (no Zoom native SDK needed).
# Platform is set in docker-compose.zoom.yml (required on Apple Silicon; Zoom SDK has no arm64 wheel).

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV MECHUS_API_HOST=0.0.0.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    python3-gi \
    curl \
    ca-certificates \
    libglib2.0-0 \
    libcairo2 \
    libgirepository1.0-dev \
    libportaudio2 \
    libgl1 \
    libasound2 \
    libasound2-plugins \
    alsa-utils \
    alsa-oss \
    libdbus-1-3 \
    pulseaudio \
    pulseaudio-utils \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI only (no daemon): api_server spawns sibling containers via mounted /var/run/docker.sock.
# Pin a known-good static build for linux/amd64 (matches docker-compose.zoom.yml platform).
# Engine 29+ rejects API < 1.44; static docker 24.x speaks 1.43 and breaks `docker run` for FaceTime workers.
ARG DOCKER_CLI_VERSION=27.4.1
RUN curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
    | tar -xz -C /tmp \
    && mv /tmp/docker/docker /usr/local/bin/docker \
    && rm -rf /tmp/docker \
    && docker --version

# ALSA → PulseAudio virtual null sink (no real sound hardware or /dev/snd needed).
# The entrypoint starts PulseAudio with module-null-sink before gunicorn.
# libasound2-plugins provides the "pulse" PCM type that routes ALSA calls to PA.
# Fallback chain: pulse → null (silent discard) so SDK init never hard-errors.
ENV ALSA_CONFIG_PATH=/etc/asound.conf
RUN printf '%s\n' \
  'pcm.!default { type pulse; fallback "null"; }' \
  'ctl.!default { type pulse; fallback "null"; }' \
  'pcm.null     { type null; }' \
  'ctl.null     { type null; }' \
  > /etc/asound.conf

WORKDIR /app

COPY requirements.txt requirements-prod.txt requirements-zoom.txt requirements-rtms.txt requirements-openwakeword.txt requirements-chert.txt ./
# Install zoom-meeting-sdk; on amd64 pip should get the pre-built wheel (no build from source).
RUN pip3 install --no-cache-dir -r requirements.txt -r requirements-prod.txt -r requirements-zoom.txt -r requirements-rtms.txt -r requirements-openwakeword.txt -r requirements-chert.txt

# Download Vosk *before* COPY mechus/ so code edits do not invalidate this layer (saves bandwidth and disk on rebuilds).
COPY scripts/download_vosk_model.py ./scripts/download_vosk_model.py
RUN mkdir -p models \
    && python3 scripts/download_vosk_model.py --out models \
    && test -d models/vosk-model-small-en-us-0.15 || (echo "Vosk model missing" && exit 1) \
    && rm -f models/vosk-model-small-en-us-0.15.zip

COPY docker-entrypoint-zoom.sh /app/docker-entrypoint-zoom.sh
RUN chmod +x /app/docker-entrypoint-zoom.sh
COPY mechus/ ./mechus/
COPY scripts/ ./scripts/
COPY main.py ./

ENV MECHUS_VOSK_MODEL_PATH=/app/models/vosk-model-small-en-us-0.15
ENV MECHUS_JOIN_BACKEND=zoom_sdk

RUN mkdir -p /app/mechus_notes && \
    useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 5000
ENV GUNICORN_WORKERS=1
ENV GUNICORN_THREADS=4
ENV GUNICORN_BIND=0.0.0.0:5000
ENV GUNICORN_TIMEOUT=120
ENTRYPOINT ["/app/docker-entrypoint-zoom.sh"]
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "4", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-", "mechus.api_server:app"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health')" || exit 1
