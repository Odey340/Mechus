# Production / API (see docs/PRODUCTION.md)
# KOOV_API_KEY=           # Required when exposed to internet; clients send X-API-Key or Authorization: Bearer <key>
# KOOV_CORS_ORIGINS=      # Comma-separated dashboard origins (e.g. https://app.example.com)
# KOOV_API_HOST=127.0.0.1
# KOOV_API_PORT=5000
# KOOV_LOG_LEVEL=INFO

# Docker-out-of-docker (FaceTime worker containers spawned from the API container).
# Required for docker-compose.zoom.yml `group_add`. Example:
# DOCKER_GID=988
# DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)
#
# Host directory bind-mounted into the API container at /app/koov_notes (must be a host path for sibling `docker run -v`).
# KOOV_HOST_NOTES_DIR=/var/koov/notes
#
# Absolute host path for FaceTime worker binds (usually set by scripts/restart-on-server.sh; export before `docker compose` if needed).
# KOOV_NOTES_HOST_PATH=/home/ubuntu/koovdemo/koov_notes

# FaceTime generated camera (Linux deployment VM only). Safe defaults keep the
# existing audio-only bot unchanged. Provision devices with
# scripts/setup_facetime_cameras.sh before enabling.
# KOOV_FT_CAMERA_FEATURE=0
# KOOV_FT_CAMERA_REQUIRED=0
# KOOV_FT_VIDEO_DEVICES=/dev/video20,/dev/video21,/dev/video22,/dev/video23
# KOOV_FT_VIDEO_WIDTH=640
# KOOV_FT_VIDEO_HEIGHT=360
# KOOV_FT_VIDEO_FPS=12
# KOOV_FT_CAMERA_AUTO_ON=0
# KOOV_FT_CAMERA_DEFAULT_MODE=avatar

# On-demand visual questions. No screenshots are retained by default.
# KOOV_FT_VISION_ENABLED=0
# KOOV_OPENAI_VISION_MODEL=
# KOOV_FT_VISION_MAX_REQUESTS_PER_MINUTE=3
# KOOV_FT_VISION_DETAIL=auto

# Lowest latency for live answers: forces lexical retrieval, disables embedding rerank, caps prompt budgets / OpenAI timeout.
# KOOV_LOW_LATENCY=1
#
# Human-like voice-agent preset (recommended for Zoom/FaceTime): enables low latency and snappier transcript
# wake timing. Barge-in defaults to stop-only on production paths (only "Koov, stop" cuts a reply).
# Pair with ElevenLabs turbo + a warm support voice (see voice IDs below).
# KOOV_CONVERSATIONAL=1
# KOOV_FOLLOWUP_WINDOW_S=45   # after a wake+reply, accept directed follow-ups (repeat/what about) without wake; 0=always require wake (default 45s with KOOV_LOW_LATENCY=1)
# KOOV_WAKE_OPENER_EXTEND_CAP_S=18  # gapless bridge fillers while LLM runs (default 18s with KOOV_LOW_LATENCY=1)

# Auto-join: browser = open meeting in Chrome and click Join (run API on host, not Docker).
# KOOV_JOIN_BACKEND=browser
# KOOV_SHOW_BROWSER=true   # true = visible Chrome (default; needed for audio and reliable auto-join). false = headless (no audio).

# Chert FaceTime API (join_backend=facetime_chert) - see docs/CHERT_FACETIME.md
# Koov joins a LiveKit room; Chert places the FaceTime call and bridges it into that room.
# CHERT_API_KEY=ftk_...          # Chert dashboard -> Developer -> Project API keys
# CHERT_PROJECT_ID=              # project UUID
# CHERT_LINE_ID=                 # FaceTime line UUID
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# KOOV_FACETIME_BACKEND=chert    # chert | web (default: chert when the keys above are set)
# KOOV_CHERT_ANSWER_TIMEOUT_S=120

# Zoom SDK (Linux/Docker only; for join_backend=zoom_sdk)
# ZOOM_APP_CLIENT_ID=
# ZOOM_APP_CLIENT_SECRET=
#
# Server-level Zoom OAuth (no per-user "Connect Zoom" in dashboard). Use a Zoom
# Server-to-Server OAuth app + your org account id. API auto-fetches ZAK for joins.
# ZOOM_ACCOUNT_ID=
# ZOOM_S2S_CLIENT_ID=          # or ZOOM_CLIENT_ID (same S2S app as dashboard OAuth)
# ZOOM_S2S_CLIENT_SECRET=
# ZOOM_BOT_USER_EMAIL=         # Zoom user on your account (e.g. contact@yourcompany.com)
# ZOOM_OAUTH_ACCESS_TOKEN=     # optional: long-lived token instead of S2S
# ZOOM_OAUTH_REFRESH_TOKEN=
# Per-participant raw audio + names from Zoom roster (replaces mixed-only + pyannote for "who spoke").
# KOOV_ZOOM_STREAM_ATTRIBUTION=1
# Default: Koov joins unmuted and stays unmuted (recommended for demos).
# Set to 1 only if you want Koov muted in Zoom between TTS replies (legacy).
# KOOV_ZOOM_MUTE_WHEN_IDLE=0
# KOOV_DIARIZATION_ENABLED=0   # recommended when stream attribution is on (diarization auto-disabled anyway)

KOOV_INPUT_DEVICE=
KOOV_OUTPUT_DEVICE=

KOOV_SAMPLE_RATE_HZ=48000
KOOV_FRAME_MS=20

# Wake words. The agent only wakes when it hears one of these.
# Comma-separated. "koov" is the primary identity; "computer" is kept as an
# active alias so the legacy phrase still works. Avoid very short aliases like
# "koo"/"coop" — they fuzzy-match normal English in transcripts and false-wake.
# Default: koov. Fuzzy matcher also accepts common STT mishears (kuv, coov, koop, hoov).
KOOV_WAKE_PHRASE=hey mechus,mechus
# Fuzzy Levenshtein per word for meeting-transcript wake only (1 or 2). Vosk wake path always uses 2.
# Set to 1 for stricter transcript matching (fewer false wakes; clearer wake pronunciation helps).
# Meeting transcript wake: 1 = stricter (fewer false wakes). Wake must start the utterance.
KOOV_WAKE_TRANSCRIPT_MAX_DIST=1
# Words allowed before "computer" in one merged transcript line (e.g. "all right that works computer …")
KOOV_WAKE_TRANSCRIPT_MAX_LEADING_WORDS=10
# Seconds of prior human transcript to prepend when wake arrives (defaults to KOOV_FOLLOWUP_WINDOW_S)
# KOOV_WAKE_TRANSCRIPT_PREAMBLE_S=12
KOOV_WAKE_BACKEND=vosk
KOOV_VOSK_MODEL_PATH=./models/vosk-model-small-en-us-0.15
KOOV_ACTIONABLE_ONLY=1
KOOV_ACTIONABLE_PHRASES=summarize,summary,recap,action items,next steps,decisions,decision,meeting notes,take notes,keep notes
KOOV_ACTIONABLE_LLM=0
KOOV_ACTIONABLE_LLM_HOST=
KOOV_ACTIONABLE_LLM_MODEL=
KOOV_ACTIONABLE_LLM_TIMEOUT_S=2.0

KOOV_REQUEST_MODE=one_shot
KOOV_WAKE_PRE_ROLL_SECONDS=0.8

KOOV_CONTEXT_SECONDS=0

KOOV_MEMORY_MAX_CHARS=8000
KOOV_MEMORY_RECENT_CHARS=2000

# STT: faster-whisper (local), openai, deepgram, assemblyai, or elevenlabs (same API key as TTS)
KOOV_STT_BACKEND=faster-whisper
# Multilingual (default): leave KOOV_WHISPER_LANGUAGE unset for auto-detect (90+ languages on Scribe).
# Set KOOV_MULTILINGUAL=0 for English-only STT. Force a language with KOOV_WHISPER_LANGUAGE=es (etc).
KOOV_MULTILINGUAL=1
KOOV_WHISPER_MODEL=base
KOOV_WHISPER_COMPUTE_TYPE=int8
# KOOV_WHISPER_LANGUAGE=

KOOV_DIARIZATION_ENABLED=0
KOOV_DIARIZATION_BACKEND=pyannote-cloud
KOOV_DIARIZATION_API_KEY=
KOOV_DIARIZATION_API_BASE_URL=https://api.pyannote.ai
KOOV_DIARIZATION_MODEL=precision-2
KOOV_DIARIZATION_EXCLUSIVE=1
KOOV_DIARIZATION_MIN_SPEAKERS=
KOOV_DIARIZATION_MAX_SPEAKERS=
KOOV_DIARIZATION_TIMEOUT_S=60
KOOV_DIARIZATION_POLL_INTERVAL_S=0.8

KOOV_TRANSCRIPT_MIN_SECONDS=0.8
KOOV_TRANSCRIPT_CHUNK_SECONDS=12
KOOV_TRANSCRIPT_END_SILENCE_SECONDS=0.7
KOOV_TRANSCRIPT_REWRITE=0
# Mic silence before playing TTS after LLM (default 0.6s). Meeting-transcript / FaceTime wake uses
# KOOV_MIN_SILENCE_BEFORE_SPEAKING_TRANSCRIPT_ST_S (default 0.18) so the answer is not held after [RESPONSE] logs.
# KOOV_MIN_SILENCE_BEFORE_SPEAKING_S=0.6
# KOOV_MIN_SILENCE_BEFORE_SPEAKING_TRANSCRIPT_ST_S=0.18

KOOV_TTS_BACKEND=elevenlabs
# KOOV_TTS_SMOOTH=1 (default): pcm_32000 for ElevenLabs, cosine fades.
# KOOV_LOW_LATENCY=1 (Zoom/FaceTime workers): thinking preroll + wake opener on by default.
# KOOV_THINKING_PREROLL=1: cached persona earcon during real LLM only (cache hits skip).
# Main answer TTS synthesize runs in parallel with the silence wait when not using streaming TTS.
# KOOV_THINKING_PREROLL=0 disables earcon. KOOV_THINKING_PREROLL_MAX_AUDIO_S: 0 = full phrase (no mid-sentence chop);
# set e.g. 0.45 only if you want a hard cap (short caps caused cut + long silence while LLM still ran).
# KOOV_THINKING_PREROLL_MIN_LLM_MS reserved / unused for now.
KOOV_THINKING_PREROLL_MIN_LLM_MS=350
# KOOV_THINKING_PREROLL_MAX_AUDIO_S=0
# Meeting-transcript / FaceTime: preroll stays on by default but uses short fillers + cap + fades.
# KOOV_THINKING_PREROLL_TRANSCRIPT_ST_MAX_S=0.5 (0 = use only KOOV_THINKING_PREROLL_MAX_AUDIO_S).
# KOOV_THINKING_PREROLL_FADE_IN_MS=10  KOOV_THINKING_PREROLL_FADE_OUT_MS=22
# KOOV_THINKING_PREROLL_TRANSCRIPT_STT=0 — gapless wake opener extend owns the LLM wait (avoids stacked fillers).
# KOOV_WAKE_OPENER=1 — short cached ack (~0.55s) then preroll until main TTS is ready.
# KOOV_TTS_FADE_IN_MS=24  KOOV_TTS_FADE_OUT_MS=16 — smooth main reply start/end (Zoom virtual mic).
# KOOV_WAKE_COOLDOWN_TRANSCRIPT_STT_S=5 — ignore re-wake on Koov's own voice echo after speaking.
# Ignore barge-in for this many ms after TTS starts (only if Zoom interrupt is enabled)
KOOV_TTS_INTERRUPT_GRACE_MS=2800
# Zoom: default off — meeting audio often includes Koov's own voice and falsely triggers barge-in
# KOOV_INTERRUPT_ON_SPEECH_ZOOM=1
# Barge-in: with KOOV_LOW_LATENCY=1, only stop directives cut Koov mid-reply (KOOV_TRANSCRIPT_BARGE_IN_STOP_ONLY=1).
# KOOV_TRANSCRIPT_BARGE_IN=1
# KOOV_TRANSCRIPT_BARGE_IN_STOP_ONLY=1

# End-of-meeting summary email (worker + API retry on /api/stop). Gmail requires an App Password.
# KOOV_EMAIL_ENABLED=1
# KOOV_EMAIL_SMTP_HOST=smtp.gmail.com
# KOOV_EMAIL_SMTP_PORT=587
# KOOV_EMAIL_USERNAME=you@gmail.com
# KOOV_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
# KOOV_EMAIL_FROM=you@gmail.com
# KOOV_EMAIL_RECIPIENTS=you@company.com,teammate@company.com
KOOV_PIPER_MODEL_PATH=./models/piper/en_US-lessac-medium.onnx
# ── ElevenLabs (TTS + STT) — live meeting agent stack ──
# TTS: eleven_flash_v2_5 (~75ms, recommended for agents). Use eleven_v3 only for expressive/dramatic delivery.
# STT: scribe_v2_realtime (~150ms WebSocket) when KOOV_ELEVEN_STT_REALTIME=1; batch scribe_v2 if 0.
KOOV_ELEVEN_API_KEY=
KOOV_ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM
KOOV_ELEVEN_MODEL_ID=eleven_flash_v2_5
KOOV_ELEVEN_AUDIO_TAGS=0
KOOV_ELEVEN_TTS_LATENCY_OPT=3
KOOV_ELEVEN_TTS_STREAM=1
KOOV_ELEVEN_STT_REALTIME=1
KOOV_ELEVEN_STT_MODEL=scribe_v2_realtime
# Override only for non-agent / high-expressiveness demos:
# KOOV_ELEVEN_MODEL_ID=eleven_v3
# KOOV_ELEVEN_AUDIO_TAGS=1
# Support-agent style voices (preview at elevenlabs.io):
#   Rachel (recommended): 21m00Tcm4TlvDq8ikWAM — calm, professional
#   Sarah: EXAVITQu4vr4xnSDxMaL — soft, conversational
#   Matilda: XrExE9yKIg1WjnnlVkGX — warm, friendly
#   Daniel: onwK4e9ZLuTAKqWW04F9 — steady British male
# KOOV_ELEVEN_OUTPUT_FORMAT=pcm_32000   # Zoom virtual mic (match sample rate, less resampling)
# KOOV_PER_PERSONA_ELEVEN_VOICES=0
KOOV_ELEVEN_BASE_URL=https://api.elevenlabs.io
KOOV_LOW_LATENCY=1

# ── Multi-persona Koov bots (one Zoom bot, many names) ──────────────────────
# Default: only the built-in default persona is loaded (less wake/TTS/warmup work).
# Default Koov only (computer/koov wake). To invite Penny/Doc/etc., pass enabled_personas at join
# or set KOOV_PERSONAS_ENABLED=penny,doc (never loads all JSON personas without an allow-list).
# KOOV_PERSONAS_DIR=koov/personas
# KOOV_PERSONAS_ENABLED=penny,doc
# KOOV_PER_PERSONA_ELEVEN_VOICES=0   # keep 0 so every persona uses KOOV_ELEVEN_VOICE_ID only
# KOOV_BOT_PERSONA_ID=penny   # optional: worker loads only this persona (multi-bot invite sets per process)
# KOOV_PENNY_VOICE_ID=
# KOOV_DOC_VOICE_ID=
# KOOV_CODEY_VOICE_ID=
# KOOV_RIZZO_VOICE_ID=

# LLM: openai (OpenAI Chat) or rules (no LLM, rule-based answers only)
KOOV_LLM_BACKEND=openai
# When KOOV_LLM_BACKEND=openai: set KOOV_OPENAI_API_KEY (same key as STT).
# KOOV_OPENAI_API_KEY=sk-...
# Two-model split (recommended): fast/cheap thinking + quality spoken responses.
# KOOV_OPENAI_THINKING_MODEL=gpt-4.1-nano   # private_thoughts, chapters, end-of-meeting summary
# KOOV_OPENAI_RESPONSE_MODEL=gpt-4o-mini    # live spoken answers (wake → reply)
# Legacy alias (maps to RESPONSE if RESPONSE unset): KOOV_OPENAI_CHAT_MODEL=gpt-4o-mini
# Use LLM for every answer (ignore structured fast path) for higher-quality responses
# KOOV_LLM_ALWAYS=1

# Jarvis lookups — web search, weather, time (koov/realtime.py). Tavily or Serper recommended for
# "find me a monitor", "what's trending", product picks; DuckDuckGo is used when no key is set.
# KOOV_TAVILY_API_KEY=
# KOOV_SERPER_API_KEY=
# KOOV_WEATHER_API_KEY=
# KOOV_DEFAULT_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Koov Properties (/properties): inspections, reports, iMessage via Chert
# ---------------------------------------------------------------------------
# AI: uses KOOV_OPENAI_API_KEY above. Set to 1 to run offline with deterministic results.
KOOV_ESTATES_FAKE_AI=0
KOOV_ESTATES_VISION_MODEL=gpt-4o
# KOOV_ESTATES_DIR=koov_notes/estates
# ElevenLabs: KOOV_ELEVEN_API_KEY + KOOV_ELEVEN_VOICE_ID above power transcripts (Scribe) and voice summaries.
KOOV_ELEVEN_BATCH_STT_MODEL=scribe_v2

# Chert (https://docs.trychert.com) - Messaging API
KOOV_CHERT_SIGNING_SECRET=
KOOV_CHERT_TENANT=
KOOV_CHERT_LINE_PHONE=+15550000000
KOOV_CHERT_LINE_ID=
# Secret from Chert -> Webhook subscriptions (events: message.received, reaction.added)
KOOV_CHERT_WEBHOOK_SECRET=
# Public URL of this server (used in report links and the webhook URL shown in Settings)
KOOV_PUBLIC_BASE_URL=

# Chert FaceTime (Bring Your Own Room) + LiveKit - optional
KOOV_CHERT_FACETIME_API_KEY=
KOOV_CHERT_PROJECT_ID=
KOOV_CHERT_FACETIME_LINE_ID=
KOOV_LIVEKIT_URL=
KOOV_LIVEKIT_API_KEY=
KOOV_LIVEKIT_API_SECRET=

# --- Chert FaceTime Video + move-in / move-out inspection (docs/CHERT_FACETIME.md) ---
# KOOV_CHERT_VIDEO=1              # FaceTime Video: Koov sees the caller's camera
# KOOV_INSPECT_MODE=move_in       # move_in | move_out (unset = normal Koov call)
# KOOV_INSPECT_UNIT=apt-4b        # which unit; move_out compares against this unit's move_in
# GEMINI_API_KEY=                 # Gemini Flash analyses the frames (falls back to OpenAI vision)
# KOOV_GEMINI_MODEL=gemini-flash-lite-latest
# MONGODB_URI=                    # move-in frames + findings (falls back to local files)
# KOOV_MONGODB_DB=koov

# ---------------------------------------------------------------------------
# Tiger Data (TimescaleDB on Tiger Cloud) - meeting analytics. See docs/TIGER_DATA.md
# Create a service at https://mlh.link/tigerdata-quickstart, then: python scripts/tiger_init.py --demo
# ---------------------------------------------------------------------------
# TIGER_DATABASE_URL=postgres://tsdbadmin:<PASSWORD>@<HOST>:<PORT>/tsdb?sslmode=require
# KOOV_TIGER_ENABLED=1
# KOOV_TIGER_RETENTION_DAYS=

# ---------------------------------------------------------------------------
# Vultr - see docs/VULTR.md
# ---------------------------------------------------------------------------
# Deploy: python scripts/vultr_deploy.py create --ssh-pubkey ~/.ssh/id_ed25519.pub && ./run.sh deploy
# VULTR_API_KEY=
# VULTR_REGION=dfw
# VULTR_PLAN=vc2-2c-4gb
#
# Answers via Vultr Serverless Inference (OpenAI-compatible). List models: python scripts/vultr_inference_check.py
# KOOV_LLM_PROVIDER=vultr
# VULTR_INFERENCE_API_KEY=
# VULTR_INFERENCE_MODEL=
# Or any OpenAI-compatible server (e.g. vLLM on a Vultr Cloud GPU):
# KOOV_OPENAI_BASE_URL=http://<gpu-ip>:8000/v1
