# Production / API (see docs/PRODUCTION.md)
# MECHUS_API_KEY=           # Required when exposed to internet; clients send X-API-Key or Authorization: Bearer <key>
# MECHUS_CORS_ORIGINS=      # Comma-separated dashboard origins (e.g. https://app.example.com)
# MECHUS_API_HOST=127.0.0.1
# MECHUS_API_PORT=5000
# MECHUS_LOG_LEVEL=INFO

# Docker-out-of-docker (FaceTime worker containers spawned from the API container).
# Required for docker-compose.zoom.yml `group_add`. Example:
# DOCKER_GID=988
# DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)
#
# Host directory bind-mounted into the API container at /app/mechus_notes (must be a host path for sibling `docker run -v`).
# MECHUS_HOST_NOTES_DIR=/var/mechus/notes
#
# Absolute host path for FaceTime worker binds (usually set by scripts/restart-on-server.sh; export before `docker compose` if needed).
# MECHUS_NOTES_HOST_PATH=/home/ubuntu/mechusdemo/mechus_notes

# FaceTime generated camera (Linux deployment VM only). Safe defaults keep the
# existing audio-only bot unchanged. Provision devices with
# scripts/setup_facetime_cameras.sh before enabling.
# MECHUS_FT_CAMERA_FEATURE=0
# MECHUS_FT_CAMERA_REQUIRED=0
# MECHUS_FT_VIDEO_DEVICES=/dev/video20,/dev/video21,/dev/video22,/dev/video23
# MECHUS_FT_VIDEO_WIDTH=640
# MECHUS_FT_VIDEO_HEIGHT=360
# MECHUS_FT_VIDEO_FPS=12
# MECHUS_FT_CAMERA_AUTO_ON=0
# MECHUS_FT_CAMERA_DEFAULT_MODE=avatar

# On-demand visual questions. No screenshots are retained by default.
# MECHUS_FT_VISION_ENABLED=0
# MECHUS_OPENAI_VISION_MODEL=
# MECHUS_FT_VISION_MAX_REQUESTS_PER_MINUTE=3
# MECHUS_FT_VISION_DETAIL=auto

# Lowest latency for live answers: forces lexical retrieval, disables embedding rerank, caps prompt budgets / OpenAI timeout.
# MECHUS_LOW_LATENCY=1
#
# Human-like voice-agent preset (recommended for Zoom/FaceTime): enables low latency and snappier transcript
# wake timing. Barge-in defaults to stop-only on production paths (only "Mechus, stop" cuts a reply).
# Pair with ElevenLabs turbo + a warm support voice (see voice IDs below).
# MECHUS_CONVERSATIONAL=1
# MECHUS_FOLLOWUP_WINDOW_S=45   # after a wake+reply, accept directed follow-ups (repeat/what about) without wake; 0=always require wake (default 45s with MECHUS_LOW_LATENCY=1)
# MECHUS_WAKE_OPENER_EXTEND_CAP_S=18  # gapless bridge fillers while LLM runs (default 18s with MECHUS_LOW_LATENCY=1)

# Auto-join: browser = open meeting in Chrome and click Join (run API on host, not Docker).
# MECHUS_JOIN_BACKEND=browser
# MECHUS_SHOW_BROWSER=true   # true = visible Chrome (default; needed for audio and reliable auto-join). false = headless (no audio).

# Chert FaceTime API (join_backend=facetime_chert) - see docs/CHERT_FACETIME.md
# Mechus joins a LiveKit room; Chert places the FaceTime call and bridges it into that room.
# CHERT_API_KEY=ftk_...          # Chert dashboard -> Developer -> Project API keys
# CHERT_PROJECT_ID=              # project UUID
# CHERT_LINE_ID=                 # FaceTime line UUID
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# MECHUS_FACETIME_BACKEND=chert    # chert | web (default: chert when the keys above are set)
# MECHUS_CHERT_ANSWER_TIMEOUT_S=120

# Zoom SDK (Linux/Docker only; for join_backend=zoom_sdk)
# ZOOM_APP_CLIENT_ID=
# ZOOM_APP_CLIENT_SECRET=
#
# Server-level Zoom OAuth (no per-user "Connect Zoom" in dashboard). Use a Zoom
# Server-to-Server OAuth app + your org account id. API auto-fetches ZAK for joins.
# ZOOM_ACCOUNT_ID=
# ZOOM_S2S_CLIENT_ID=          # or ZOOM_CLIENT_ID (same S2S app as dashboard OAuth)
# ZOOM_S2S_CLIENT_SECRET=
# ZOOM_BOT_USER_EMAIL=         # Zoom user on your account (e.g. contact@yourcompany.com)
# ZOOM_OAUTH_ACCESS_TOKEN=     # optional: long-lived token instead of S2S
# ZOOM_OAUTH_REFRESH_TOKEN=
# Per-participant raw audio + names from Zoom roster (replaces mixed-only + pyannote for "who spoke").
# MECHUS_ZOOM_STREAM_ATTRIBUTION=1
# Default: Mechus joins unmuted and stays unmuted (recommended for demos).
# Set to 1 only if you want Mechus muted in Zoom between TTS replies (legacy).
# MECHUS_ZOOM_MUTE_WHEN_IDLE=0
# MECHUS_DIARIZATION_ENABLED=0   # recommended when stream attribution is on (diarization auto-disabled anyway)

MECHUS_INPUT_DEVICE=
MECHUS_OUTPUT_DEVICE=

MECHUS_SAMPLE_RATE_HZ=48000
MECHUS_FRAME_MS=20

# Wake words. The agent only wakes when it hears one of these.
# Comma-separated. "mechus" is the primary identity; "computer" is kept as an
# active alias so the legacy phrase still works. Avoid very short aliases like
# "koo"/"coop" — they fuzzy-match normal English in transcripts and false-wake.
# Default: mechus. Fuzzy matcher also accepts common STT mishears (kuv, coov, koop, hoov).
MECHUS_WAKE_PHRASE=hey mechus,mechus
# Fuzzy Levenshtein per word for meeting-transcript wake only (1 or 2). Vosk wake path always uses 2.
# Set to 1 for stricter transcript matching (fewer false wakes; clearer wake pronunciation helps).
# Meeting transcript wake: 1 = stricter (fewer false wakes). Wake must start the utterance.
MECHUS_WAKE_TRANSCRIPT_MAX_DIST=1
# Words allowed before "computer" in one merged transcript line (e.g. "all right that works computer …")
MECHUS_WAKE_TRANSCRIPT_MAX_LEADING_WORDS=10
# Seconds of prior human transcript to prepend when wake arrives (defaults to MECHUS_FOLLOWUP_WINDOW_S)
# MECHUS_WAKE_TRANSCRIPT_PREAMBLE_S=12
MECHUS_WAKE_BACKEND=vosk
MECHUS_VOSK_MODEL_PATH=./models/vosk-model-small-en-us-0.15
MECHUS_ACTIONABLE_ONLY=1
MECHUS_ACTIONABLE_PHRASES=summarize,summary,recap,action items,next steps,decisions,decision,meeting notes,take notes,keep notes
MECHUS_ACTIONABLE_LLM=0
MECHUS_ACTIONABLE_LLM_HOST=
MECHUS_ACTIONABLE_LLM_MODEL=
MECHUS_ACTIONABLE_LLM_TIMEOUT_S=2.0

MECHUS_REQUEST_MODE=one_shot
MECHUS_WAKE_PRE_ROLL_SECONDS=0.8

MECHUS_CONTEXT_SECONDS=0

MECHUS_MEMORY_MAX_CHARS=8000
MECHUS_MEMORY_RECENT_CHARS=2000

# STT: faster-whisper (local), openai, deepgram, assemblyai, or elevenlabs (same API key as TTS)
MECHUS_STT_BACKEND=faster-whisper
# Multilingual (default): leave MECHUS_WHISPER_LANGUAGE unset for auto-detect (90+ languages on Scribe).
# Set MECHUS_MULTILINGUAL=0 for English-only STT. Force a language with MECHUS_WHISPER_LANGUAGE=es (etc).
MECHUS_MULTILINGUAL=1
MECHUS_WHISPER_MODEL=base
MECHUS_WHISPER_COMPUTE_TYPE=int8
# MECHUS_WHISPER_LANGUAGE=

MECHUS_DIARIZATION_ENABLED=0
MECHUS_DIARIZATION_BACKEND=pyannote-cloud
MECHUS_DIARIZATION_API_KEY=
MECHUS_DIARIZATION_API_BASE_URL=https://api.pyannote.ai
MECHUS_DIARIZATION_MODEL=precision-2
MECHUS_DIARIZATION_EXCLUSIVE=1
MECHUS_DIARIZATION_MIN_SPEAKERS=
MECHUS_DIARIZATION_MAX_SPEAKERS=
MECHUS_DIARIZATION_TIMEOUT_S=60
MECHUS_DIARIZATION_POLL_INTERVAL_S=0.8

MECHUS_TRANSCRIPT_MIN_SECONDS=0.8
MECHUS_TRANSCRIPT_CHUNK_SECONDS=12
MECHUS_TRANSCRIPT_END_SILENCE_SECONDS=0.7
MECHUS_TRANSCRIPT_REWRITE=0
# Mic silence before playing TTS after LLM (default 0.6s). Meeting-transcript / FaceTime wake uses
# MECHUS_MIN_SILENCE_BEFORE_SPEAKING_TRANSCRIPT_ST_S (default 0.18) so the answer is not held after [RESPONSE] logs.
# MECHUS_MIN_SILENCE_BEFORE_SPEAKING_S=0.6
# MECHUS_MIN_SILENCE_BEFORE_SPEAKING_TRANSCRIPT_ST_S=0.18

MECHUS_TTS_BACKEND=elevenlabs
# MECHUS_TTS_SMOOTH=1 (default): pcm_32000 for ElevenLabs, cosine fades.
# MECHUS_LOW_LATENCY=1 (Zoom/FaceTime workers): thinking preroll + wake opener on by default.
# MECHUS_THINKING_PREROLL=1: cached persona earcon during real LLM only (cache hits skip).
# Main answer TTS synthesize runs in parallel with the silence wait when not using streaming TTS.
# MECHUS_THINKING_PREROLL=0 disables earcon. MECHUS_THINKING_PREROLL_MAX_AUDIO_S: 0 = full phrase (no mid-sentence chop);
# set e.g. 0.45 only if you want a hard cap (short caps caused cut + long silence while LLM still ran).
# MECHUS_THINKING_PREROLL_MIN_LLM_MS reserved / unused for now.
MECHUS_THINKING_PREROLL_MIN_LLM_MS=350
# MECHUS_THINKING_PREROLL_MAX_AUDIO_S=0
# Meeting-transcript / FaceTime: preroll stays on by default but uses short fillers + cap + fades.
# MECHUS_THINKING_PREROLL_TRANSCRIPT_ST_MAX_S=0.5 (0 = use only MECHUS_THINKING_PREROLL_MAX_AUDIO_S).
# MECHUS_THINKING_PREROLL_FADE_IN_MS=10  MECHUS_THINKING_PREROLL_FADE_OUT_MS=22
# MECHUS_THINKING_PREROLL_TRANSCRIPT_STT=0 — gapless wake opener extend owns the LLM wait (avoids stacked fillers).
# MECHUS_WAKE_OPENER=1 — short cached ack (~0.55s) then preroll until main TTS is ready.
# MECHUS_TTS_FADE_IN_MS=24  MECHUS_TTS_FADE_OUT_MS=16 — smooth main reply start/end (Zoom virtual mic).
# MECHUS_WAKE_COOLDOWN_TRANSCRIPT_STT_S=5 — ignore re-wake on Mechus's own voice echo after speaking.
# Ignore barge-in for this many ms after TTS starts (only if Zoom interrupt is enabled)
MECHUS_TTS_INTERRUPT_GRACE_MS=2800
# Zoom: default off — meeting audio often includes Mechus's own voice and falsely triggers barge-in
# MECHUS_INTERRUPT_ON_SPEECH_ZOOM=1
# Barge-in: with MECHUS_LOW_LATENCY=1, only stop directives cut Mechus mid-reply (MECHUS_TRANSCRIPT_BARGE_IN_STOP_ONLY=1).
# MECHUS_TRANSCRIPT_BARGE_IN=1
# MECHUS_TRANSCRIPT_BARGE_IN_STOP_ONLY=1

# End-of-meeting summary email (worker + API retry on /api/stop). Gmail requires an App Password.
# MECHUS_EMAIL_ENABLED=1
# MECHUS_EMAIL_SMTP_HOST=smtp.gmail.com
# MECHUS_EMAIL_SMTP_PORT=587
# MECHUS_EMAIL_USERNAME=you@gmail.com
# MECHUS_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
# MECHUS_EMAIL_FROM=you@gmail.com
# MECHUS_EMAIL_RECIPIENTS=you@company.com,teammate@company.com
MECHUS_PIPER_MODEL_PATH=./models/piper/en_US-lessac-medium.onnx
# ── ElevenLabs (TTS + STT) — live meeting agent stack ──
# TTS: eleven_flash_v2_5 (~75ms, recommended for agents). Use eleven_v3 only for expressive/dramatic delivery.
# STT: scribe_v2_realtime (~150ms WebSocket) when MECHUS_ELEVEN_STT_REALTIME=1; batch scribe_v2 if 0.
MECHUS_ELEVEN_API_KEY=
MECHUS_ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM
MECHUS_ELEVEN_MODEL_ID=eleven_flash_v2_5
MECHUS_ELEVEN_AUDIO_TAGS=0
MECHUS_ELEVEN_TTS_LATENCY_OPT=3
MECHUS_ELEVEN_TTS_STREAM=1
MECHUS_ELEVEN_STT_REALTIME=1
MECHUS_ELEVEN_STT_MODEL=scribe_v2_realtime
# Override only for non-agent / high-expressiveness demos:
# MECHUS_ELEVEN_MODEL_ID=eleven_v3
# MECHUS_ELEVEN_AUDIO_TAGS=1
# Support-agent style voices (preview at elevenlabs.io):
#   Rachel (recommended): 21m00Tcm4TlvDq8ikWAM — calm, professional
#   Sarah: EXAVITQu4vr4xnSDxMaL — soft, conversational
#   Matilda: XrExE9yKIg1WjnnlVkGX — warm, friendly
#   Daniel: onwK4e9ZLuTAKqWW04F9 — steady British male
# MECHUS_ELEVEN_OUTPUT_FORMAT=pcm_32000   # Zoom virtual mic (match sample rate, less resampling)
# MECHUS_PER_PERSONA_ELEVEN_VOICES=0
MECHUS_ELEVEN_BASE_URL=https://api.elevenlabs.io
MECHUS_LOW_LATENCY=1

# ── Multi-persona Mechus bots (one Zoom bot, many names) ──────────────────────
# Default: only the built-in default persona is loaded (less wake/TTS/warmup work).
# Default Mechus only (computer/mechus wake). To invite Penny/Doc/etc., pass enabled_personas at join
# or set MECHUS_PERSONAS_ENABLED=penny,doc (never loads all JSON personas without an allow-list).
# MECHUS_PERSONAS_DIR=mechus/personas
# MECHUS_PERSONAS_ENABLED=penny,doc
# MECHUS_PER_PERSONA_ELEVEN_VOICES=0   # keep 0 so every persona uses MECHUS_ELEVEN_VOICE_ID only
# MECHUS_BOT_PERSONA_ID=penny   # optional: worker loads only this persona (multi-bot invite sets per process)
# MECHUS_PENNY_VOICE_ID=
# MECHUS_DOC_VOICE_ID=
# MECHUS_CODEY_VOICE_ID=
# MECHUS_RIZZO_VOICE_ID=

# LLM: openai (OpenAI Chat) or rules (no LLM, rule-based answers only)
MECHUS_LLM_BACKEND=openai
# When MECHUS_LLM_BACKEND=openai: set MECHUS_OPENAI_API_KEY (same key as STT).
# MECHUS_OPENAI_API_KEY=sk-...
# Two-model split (recommended): fast/cheap thinking + quality spoken responses.
# MECHUS_OPENAI_THINKING_MODEL=gpt-4.1-nano   # private_thoughts, chapters, end-of-meeting summary
# MECHUS_OPENAI_RESPONSE_MODEL=gpt-4o-mini    # live spoken answers (wake → reply)
# Legacy alias (maps to RESPONSE if RESPONSE unset): MECHUS_OPENAI_CHAT_MODEL=gpt-4o-mini
# Use LLM for every answer (ignore structured fast path) for higher-quality responses
# MECHUS_LLM_ALWAYS=1

# Jarvis lookups — web search, weather, time (mechus/realtime.py). Tavily or Serper recommended for
# "find me a monitor", "what's trending", product picks; DuckDuckGo is used when no key is set.
# MECHUS_TAVILY_API_KEY=
# MECHUS_SERPER_API_KEY=
# MECHUS_WEATHER_API_KEY=
# MECHUS_DEFAULT_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Mechus Properties (/properties): inspections, reports, iMessage via Chert
# ---------------------------------------------------------------------------
# AI: uses MECHUS_OPENAI_API_KEY above. Set to 1 to run offline with deterministic results.
MECHUS_ESTATES_FAKE_AI=0
MECHUS_ESTATES_VISION_MODEL=gpt-4o
# MECHUS_ESTATES_DIR=mechus_notes/estates
# ElevenLabs: MECHUS_ELEVEN_API_KEY + MECHUS_ELEVEN_VOICE_ID above power transcripts (Scribe) and voice summaries.
MECHUS_ELEVEN_BATCH_STT_MODEL=scribe_v2

# Chert (https://docs.trychert.com) - Messaging API
MECHUS_CHERT_SIGNING_SECRET=
MECHUS_CHERT_TENANT=
MECHUS_CHERT_LINE_PHONE=+15550000000
MECHUS_CHERT_LINE_ID=
# Secret from Chert -> Webhook subscriptions (events: message.received, reaction.added)
MECHUS_CHERT_WEBHOOK_SECRET=
# Public URL of this server (used in report links and the webhook URL shown in Settings)
MECHUS_PUBLIC_BASE_URL=

# Chert FaceTime (Bring Your Own Room) + LiveKit - optional
MECHUS_CHERT_FACETIME_API_KEY=
MECHUS_CHERT_PROJECT_ID=
MECHUS_CHERT_FACETIME_LINE_ID=
MECHUS_LIVEKIT_URL=
MECHUS_LIVEKIT_API_KEY=
MECHUS_LIVEKIT_API_SECRET=

# --- Chert FaceTime Video + move-in / move-out inspection (docs/CHERT_FACETIME.md) ---
# MECHUS_CHERT_VIDEO=1              # FaceTime Video: Mechus sees the caller's camera
# MECHUS_INSPECT_MODE=move_in       # move_in | move_out (unset = normal Mechus call)
# MECHUS_INSPECT_UNIT=apt-4b        # which unit; move_out compares against this unit's move_in
# GEMINI_API_KEY=                 # Gemini Flash analyses the frames (falls back to OpenAI vision)
# MECHUS_GEMINI_MODEL=gemini-flash-lite-latest
# MONGODB_URI=                    # move-in frames + findings (falls back to local files)
# MECHUS_MONGODB_DB=mechus

# ---------------------------------------------------------------------------
# Tiger Data (TimescaleDB on Tiger Cloud) - meeting analytics. See docs/TIGER_DATA.md
# Create a service at https://mlh.link/tigerdata-quickstart, then: python scripts/tiger_init.py --demo
# ---------------------------------------------------------------------------
# TIGER_DATABASE_URL=postgres://tsdbadmin:<PASSWORD>@<HOST>:<PORT>/tsdb?sslmode=require
# MECHUS_TIGER_ENABLED=1
# MECHUS_TIGER_RETENTION_DAYS=

# ---------------------------------------------------------------------------
# Vultr - see docs/VULTR.md
# ---------------------------------------------------------------------------
# Deploy: python scripts/vultr_deploy.py create --ssh-pubkey ~/.ssh/id_ed25519.pub && ./run.sh deploy
# VULTR_API_KEY=
# VULTR_REGION=dfw
# VULTR_PLAN=vc2-2c-4gb
#
# Answers via Vultr Serverless Inference (OpenAI-compatible). List models: python scripts/vultr_inference_check.py
# MECHUS_LLM_PROVIDER=vultr
# VULTR_INFERENCE_API_KEY=
# VULTR_INFERENCE_MODEL=
# Or any OpenAI-compatible server (e.g. vLLM on a Vultr Cloud GPU):
# MECHUS_OPENAI_BASE_URL=http://<gpu-ip>:8000/v1
